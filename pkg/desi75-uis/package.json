{
	"name": "desi75-uis",
	"description": "feli-package desi75-uis for installing locally the web-ui desi75-ui",
	"version": "0.1.1",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MYNAME/parame75.git"
	},
	"homepage": "https://MYNAME.github.io/parame75/",
	"author": "MYNAME",
	"license": "ISC",
	"keywords": [
		"parametrix",
		"3D",
		"CAD"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/desi75-uis.d.ts",
			"default": "./dist/desi75-uis.js"
		}
	},
	"bin": {
		"desi75-uis": "dist/desi75-uis.js"
	},
	"files": [
		"dist/",
		"!dist/**/*.d.ts",
		"!dist/**/*.map",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"tsup": {
		"entry": [
			"src/desi75-uis.ts"
		],
		"format": "esm",
		"splitting": false,
		"dts": false,
		"sourcemap": false,
		"clean": true
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "none",
		"printWidth": 100,
		"plugins": [],
		"overrides": []
	},
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"check": "tsc --noEmit",
		"pretty": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test:unit:once": "vitest --run",
		"clean_public": "rimraf dist/public",
		"copy_ui": "shx cp -r ../desi75-ui/build dist/public",
		"checkCopy": "ls -l dist/public/index.html",
		"copy_public": "run-s clean_public copy_ui checkCopy",
		"ci": "run-s check build pretty lint test:unit:once copy_public",
		"run": "node dist/desi75-uis.js",
		"run-help": "node dist/desi75-uis.js --help",
		"clean": "rimraf node_modules build dist tmp"
	},
	"dependencies": {
		"feli": "^1.0.16"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/eslint__js": "^8.42.3",
		"@types/node": "^26.2.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"shx": "^0.4.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	}
}
