{
	"name": "desi75",
	"version": "0.1.8",
	"description": "A collection of 3D-designs",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/charlyoleg2/parame75.git"
	},
	"homepage": "https://charlyoleg2.github.io/parame75/",
	"author": "charlyoleg2",
	"license": "ISC",
	"keywords": [
		"parametrix",
		"3D",
		"CAD"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"tsdown": {
		"entry": [
			"src/index.ts"
		],
		"format": "esm",
		"target": "esnext",
		"fixedExtension": false,
		"splitting": false,
		"dts": true,
		"sourcemap": true,
		"clean": true
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"pretty": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test:unit:once": "vitest --run",
		"ci": "run-s check build pretty lint test:unit:once svgo",
		"svgo1": "svgo -f src/myGroup1/svg -o dist/pgdsvg/",
		"svgo": "run-s svgo1",
		"browserBundleA": "rolldown src/myGroup1/pastePusher.ts -f esm -ou dist2/pastePusher.js",
		"browserBundleAll": "rolldown dist/index.js -f esm -o dist2/desi75.js",
		"clean": "rimraf dist dist2 node_modules"
	},
	"dependencies": {
		"geometrix": "^1.0.41"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/eslint__js": "^8.42.3",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"rolldown": "^1.2.14",
		"svgo": "^4.1.0",
		"tsdown": "^0.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
